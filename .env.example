# Copy to .env and fill in. NEVER commit .env with real secrets.
# Local dev works with everything commented out (SQLite + memory fallbacks).

# Postgres (compose/k8s). Example: postgresql+psycopg://lab:lab@db:5432/lab
DATABASE_URL=

# Redis (compose/k8s). Example: redis://cache:6379/0
REDIS_URL=

# Postgres password used by docker compose (required in compose, no default).
POSTGRES_PASSWORD=

# Grafana admin password (compose default: lab).
GRAFANA_PASSWORD=

# API key: when set, /api/* and /chaos require header X-API-Key.
API_KEY=

# Set to 0 to disable the /chaos failure-injection hook entirely.
CHAOS_ENABLED=1

# Per-IP rate limit (requests/sec, 0 = disabled). Burst bucket size below.
RATE_LIMIT_RPS=0
RATE_LIMIT_BURST=50

# Pagination cap for list endpoints.
PAGE_SIZE_MAX=100

# SQLAlchemy pool (Postgres only).
POOL_SIZE=5
POOL_MAX_OVERFLOW=10

# INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Tracing: 1 to enable OTEL (console exporter unless OTLP endpoint set).
OTEL_ENABLED=0
OTEL_EXPORTER_OTLP_ENDPOINT=
